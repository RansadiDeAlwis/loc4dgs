# Python / test caches
__pycache__/
*.pyc
.pytest_cache/

# Results: keep the CSVs, tables, figures, GIFs and logs (everything the report cites),
# but not the bulky per-run visualization files (200 MB, regenerated by --save_vis)
# or the private backup taken before the EKF tuning
results/vis/
results/backup_before_ekf_tuning/
results/landscape_*.npz

# Report: keep main.tex, references.bib, figures/ and the compiled main.pdf;
# drop LaTeX build files, the Overleaf sync settings and the local backup copy
report/.localleaf/
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.toc
report/*.lof
report/*.lot
report/*.run.xml
report/*.synctex.gz
report_backup/

# Dataset and pretrained models live outside the repo (../data, ../output; see download_data.sh)
data/
output/
